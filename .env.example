# ============================================================
#  Sistem Informasi Desa (SID) — Konfigurasi Lingkungan
#  Salin ke .env lalu sesuaikan. JANGAN commit .env.
# ============================================================
APP_NAME="Sistem Informasi Desa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Zona waktu desa untuk PENYAJIAN (data selalu disimpan UTC)
VILLAGE_TIMEZONE=Asia/Jakarta

# --- Basis data (MySQL 8.0 — lihat docs/05-model-data.md §6) -------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sid_desa
DB_USERNAME=sid_app
DB_PASSWORD=sid_local_dev
# Produksi WAJIB: MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- Enkripsi data pribadi (ADR-004) ------------------------------------
# WAJIB diisi. Buat dengan: php artisan sid:generate-pii-keys
# Kehilangan PII_ENCRYPTION_KEY = kehilangan semua NIK & nomor KK.
# Perubahan PII_HASH_PEPPER membatalkan semua indeks pencarian NIK.
PII_ENCRYPTION_KEY=
PII_HASH_PEPPER=

# --- Cache / Queue / Session --------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Kebijakan autentikasi (docs/08 §3) ---------------------------------
AUTH_ADMIN_SESSION_IDLE_MINUTES=30
AUTH_ADMIN_SESSION_ABSOLUTE_HOURS=12
AUTH_CITIZEN_SESSION_DAYS=14
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=30
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_REQUIRE_2FA_ROLES=admin_desa,kepala_desa

# --- Berkas -------------------------------------------------------------
FILESYSTEM_DISK=local
# Produksi (S3-kompatibel):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_DEFAULT_REGION=
# AWS_BUCKET= / AWS_ENDPOINT= / AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Notifikasi ---------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@desa.example.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- PDF (Fase S5) ------------------------------------------------------
GOTENBERG_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Collation wajib utf8mb4_0900_ai_ci (docs/05-model-data.md §6)
DB_COLLATION=utf8mb4_0900_ai_ci
